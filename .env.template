# App config
NODE_ENV=local


# Frontend related
FRONTEND_BACKEND_BASE_URL=http://localhost:3001
FRONTEND_FIREBASE_API_KEY=your-api-key
FRONTEND_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FRONTEND_FIREBASE_PROJECT_ID=your-project-id
FRONTEND_ENABLE_MOCK_AUTH=false
FRONTEND_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Backend related
BACKEND_PORT=3001
BACKEND_BUILD_MODE=swc
BACKEND_CLIENT_HOST=http://localhost:3000
BACKEND_COOKIE_SECRET=something_secret
BACKEND_COOKIE_DOMAIN_NAME=localhost

# Backend feature flag
# Firebase Auth Emulator gate — must be false in production / staging
BACKEND_ENABLE_MOCK_AUTH=false
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
BACKEND_ENABLE_HISTORY=false
BACKEND_ENABLE_PROFILE=false


# Database related
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=Password1234
DATABASE_DB=project_db

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Firebase Admin SDK
FIREBASE_PROJECT_ID=maintenance-tracker-e2e
FIREBASE_CLIENT_EMAIL=placeholder@example.com
FIREBASE_PRIVATE_KEY="placeholder"

# Email provider
EMAIL_PROVIDER="postmark"
POSTMARK_API_KEY=your-postmark-api-key
POSTMARK_FROM_ADDRESS=no-reply@yourdomain.com
AWS_SES_REGION="us-east-1"
AWS_SES_FROM_ADDRESS=no-reply@yourdomain.com

# Maintenance thresholds
MILEAGE_WARNING_THRESHOLD_KM="500"
NOTIFICATION_DAYS_BEFORE="7"
NOTIFICATION_CRON_SCHEDULE="0 8 * * *"

