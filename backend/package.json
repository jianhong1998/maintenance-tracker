{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write .",
    "dev": "nodemon --watch src --watch ../packages/types --ext ts --exec ts-node -r dotenv/config -r tsconfig-paths/register src/main.ts",
    "dev:worker": "nodemon --watch src --watch ../packages/types --ext ts --exec ts-node -r dotenv/config -r tsconfig-paths/register src/main-worker.ts",
    "start": "node dist/backend/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typeorm": "DOTENV_CONFIG_PATH=../.env pnpm exec ts-node --project tsconfig.cli.json -r dotenv/config -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/db/migration-config/data-source.ts",
    "typeorm-extension": "DOTENV_CONFIG_PATH=../.env pnpm exec ts-node --project tsconfig.cli.json -r dotenv/config -r tsconfig-paths/register ./node_modules/typeorm-extension/bin/cli.cjs -d src/db/migration-config/data-source.ts",
    "migration:generate": "bash scripts/generate-db-migration.sh",
    "migration:run": "npm run typeorm -- migration:run",
    "seed:create": "npx typeorm-extension seed:create -n src/db/seeders/$npm_config_name",
    "seed:run": "npm run typeorm-extension -- seed:run"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1075.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/typeorm": "^11.0.2",
    "@project/types": "workspace:*",
    "bullmq": "^5.79.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "firebase-admin": "^13.10.0",
    "nodemon": "^3.1.14",
    "pg": "^8.22.0",
    "postmark": "4.0.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.30",
    "uuid": "^11.1.1",
    "uuidv7": "^1.2.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.27",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.43",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.0",
    "@types/supertest": "^6.0.3",
    "@vitest/ui": "^3.2.6",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "prettier": "^3.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm-extension": "^3.9.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^3.2.6"
  }
}
