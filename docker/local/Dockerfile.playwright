FROM mcr.microsoft.com/playwright:v1.62.1-jammy

# Install pnpm (matches CircleCI install)
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

# No `just` needed: global-setup.ts only wipes the Firebase emulator (per-test
# users isolate user-scoped data). The pipeline resets Postgres out-of-band via
# the migration service, so this image never touches the DB. Dev runs happen
# on the host, which has just available.

WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml turbo.json ./
COPY packages ./packages
COPY backend/package.json ./backend/
COPY frontend/package.json ./frontend/
COPY api-test/package.json ./api-test/
COPY e2e/package.json ./e2e/

RUN pnpm install --frozen-lockfile --ignore-scripts

# Build shared types so e2e fixtures importing @project/types resolve at runtime.
RUN pnpm run build --filter=@project/types

COPY . .

WORKDIR /app/e2e

ENV E2E_FRONTEND_URL=http://localhost:3000
ENV E2E_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

CMD ["pnpm", "test"]
